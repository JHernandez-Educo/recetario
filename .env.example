# Copy to .env and fill in. .env is never committed.
POSTGRES_USER=recetario_admin
POSTGRES_PASSWORD=
AGENT_RO_PASSWORD=
JULIO_PG_PASSWORD=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
# Optional: Dagster UI port on this machine (default 3000)
DAGSTER_UI_PORT=
# Optional: lake folder (default az://lake/ducklake = production). Dev machines use az://lake/dev
LAKE_BUCKET_URL=
